[Unit]
Description=Easysort motion recording (15-minute windows to R2)
Wants=network-online.target
After=network-online.target easysort-firstboot.service
# Keep retrying forever: the camera or network may come later.
StartLimitIntervalSec=0

[Service]
User=easysort
Group=easysort
SupplementaryGroups=video
WorkingDirectory=/opt/easysort-motion
Environment=PYTHONUNBUFFERED=1
# On first boot easysort-firstboot is still installing python3-opencv and
# ffmpeg; wait for it quietly instead of crashing. Tailscale and enrolment
# are not waited for: windows queue until the device token exists.
ExecStartPre=/bin/sh -c 'until [ -f /etc/easysort/packages-ready ]; do sleep 5; done'
TimeoutStartSec=infinity
ExecStart=/usr/bin/python3 /opt/easysort-motion/motion_capture.py --data /var/lib/easysort-motion --device-token /etc/easysort/device-token --snapshots /run/easysort-motion
StateDirectory=easysort-motion
# Images for the camera check page, in RAM. Kept over a restart.
RuntimeDirectory=easysort-motion
RuntimeDirectoryMode=0750
RuntimeDirectoryPreserve=restart
Restart=always
RestartSec=10
# On stop, SIGTERM only motion_capture.py; it closes ffmpeg's stdin so the
# open part is finished cleanly. Anything left after the timeout is killed.
KillMode=mixed
TimeoutStopSec=120

[Install]
WantedBy=multi-user.target
